  "chunks": [
    {
      "text": "Fieldworks",
      "start": 0.0,
      "duration": 1.65
    },
    {
      "text": "Generative artworks and interactive environments by Brad Necyk.",
      "start": 1.83,
      "duration": 5.15
    },
    {
      "text": "A surface that answers. A fold in seeing. An unfinished sky. Impossible matter. A river remembering a drawing. A small vocabulary, an expanding field. A field of competing futures. A picture with weight. A room that keeps trying to sing. A history in formation. A manual, held differently. A drawing that keeps swimming. A face held beyond the glass.",
      "start": 7.16,
      "duration": 24.3
    },
    {
      "text": "Fourteen living artworks. Enter, explore, and see what a gesture changes.",
      "start": 31.64,
      "duration": 5.825
    }
  ],
